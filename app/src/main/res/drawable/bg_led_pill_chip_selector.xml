<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_led_btn_selected_bg" />
            <stroke android:width="1.5dp" android:color="@color/color_led_btn_selected_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_led_btn_selected_bg" />
            <stroke android:width="1.5dp" android:color="@color/color_led_btn_selected_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_led_btn_unselected_bg" />
            <stroke android:width="1dp" android:color="@color/color_led_btn_unselected_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
