<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_black_radius"
    android:paddingTop="@dimen/size16"
    android:paddingBottom="@dimen/size24">

    <!-- Close Button Top Right -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnClose"
        android:layout_width="@dimen/size32"
        android:layout_height="@dimen/size32"
        android:layout_marginTop="@dimen/size4"
        android:layout_marginEnd="@dimen/size16"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/size6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close" />

    <!-- Bulb Emotion Illustration (0..5 stars) -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivRatingEmotion"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="@dimen/size12"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@mipmap/ic_ratting_0" />

    <!-- Title -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size24"
        android:layout_marginTop="@dimen/size16"
        android:gravity="center"
        android:textColor="@color/text_main"
        android:textSize="@dimen/size18"
        app:fontFamily="@font/plus_jakarta_sans_semi_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivRatingEmotion"
        tools:text="Do you like &quot;Flashlight&quot;?" />

    <!-- Subtitle / Guide Message -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size24"
        android:layout_marginTop="@dimen/size8"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/text_gray"
        android:textSize="@dimen/size14"
        app:fontFamily="@font/plus_jakarta_sans_regular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        tools:text="Your feedback helps us improve. Please take a moment to rate your experience." />

    <!-- 5 Stars Rating Bar -->
    <per.wsj.library.AndRatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/size20"
        app:bgDrawable="@drawable/ic_star_normal"
        app:keepOriginColor="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMessage"
        app:starDrawable="@drawable/ic_star_selected"
        app:starSpacing="@dimen/size10" />

    <!-- Submit Button (Always Submit) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmit"
        style="@style/StyleSubmitButton"
        android:layout_marginTop="@dimen/size24"
        android:text="@string/submit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ratingBar" />

</androidx.constraintlayout.widget.ConstraintLayout>
