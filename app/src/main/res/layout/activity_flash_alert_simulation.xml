<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 0. Fullscreen Background Image: bg_splash -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/bg_splash" />

    <!-- Dark subtle overlay for contrast and legibility -->
    <View
        android:id="@+id/viewBackgroundOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#26000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Bar with Back Button -->
    <FrameLayout
        android:id="@+id/layoutSimulationHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size88"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/size24"
            android:layout_height="@dimen/size24"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/size20"
            android:layout_marginBottom="@dimen/size10"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back" />

    </FrameLayout>

    <!-- 1. CALL SIMULATION VIEW -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCallSimulation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSimulationHeader"
        tools:visibility="visible">

        <!-- Center: Caller Name & Phone Number in the middle of screen -->
        <LinearLayout
            android:id="@+id/layoutCallerInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            app:layout_constraintBottom_toTopOf="@+id/layoutArrows"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.45">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSimulationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="28sp"
                tools:text="Incoming Calls" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSimulationSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:textColor="#E6FFFFFF"
                android:textSize="18sp"
                tools:text="0989 999 999"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Glowing Neon Waves Decorative Area -->
        <View
            android:id="@+id/viewWaveGlow"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@drawable/bg_power_glow_dj"
            app:layout_constraintBottom_toBottomOf="@+id/btnAnswerCall"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layoutArrows" />

        <!-- Upward pulsing arrows -->
        <ImageView
            android:id="@+id/layoutArrows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_scroll_calling"
            app:layout_constraintBottom_toTopOf="@+id/btnAnswerCall"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Call Answer Green Circular Button -->
        <FrameLayout
            android:id="@+id/btnAnswerCall"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="54dp"
            android:background="@drawable/bg_call_pulsing_button"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_call"
                app:tint="@color/white" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. SMS SIMULATION VIEW -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutSmsSimulation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/size20"
        android:paddingTop="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSimulationHeader"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Chat message bubble 1 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chat_bubble_left"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:includeFontPadding="false"
                android:maxWidth="280dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="@string/test_sms_content_1"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <!-- Chat message bubble 2 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chat_bubble_left"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:includeFontPadding="false"
                android:maxWidth="280dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="@string/test_sms_content_2"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <!-- Chat message bubble 3 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chat_bubble_left"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:includeFontPadding="false"
                android:maxWidth="280dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="@string/test_sms_content_3"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <!-- Chat message bubble 4 -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chat_bubble_left"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:includeFontPadding="false"
                android:maxWidth="280dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="@string/test_sms_content_4"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. NOTIFICATION SIMULATION VIEW -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutNotiSimulation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSimulationHeader"
        tools:visibility="gone">

        <!-- Top Notification Banner -->
        <LinearLayout
            android:id="@+id/bannerNotification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size15"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_noti_test_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Yellow Hero Circle Bell -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_hero_circle_noti">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                    android:includeFontPadding="false"
                    android:text="@string/test_notification_title"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/plus_jakarta_sans_regular"
                    android:includeFontPadding="false"
                    android:text="@string/test_notification_body"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:includeFontPadding="false"
                android:text="@string/now"
                android:textColor="@color/color_flash_alert_subtext"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Lockscreen Big Digital Clock -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLockscreenClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_semi_bold"
            android:includeFontPadding="false"
            android:text="12:22"
            android:textColor="@color/white"
            android:textSize="64sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bannerNotification"
            app:layout_constraintVertical_bias="0.25" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
