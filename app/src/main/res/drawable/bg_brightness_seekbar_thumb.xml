<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop shadow outer halo 1 (Blur spread ~7dp) -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="oval">
            <size
                android:width="36dp"
                android:height="36dp" />
            <solid android:color="@color/color_seekbar_thumb_glow_08" />
        </shape>
    </item>

    <!-- Drop shadow halo 2 (~5dp blur) -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <size
                android:width="32dp"
                android:height="32dp" />
            <solid android:color="@color/color_seekbar_thumb_glow_15" />
        </shape>
    </item>

    <!-- Drop shadow halo 3 (~3dp blur) -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <size
                android:width="28dp"
                android:height="28dp" />
            <solid android:color="@color/color_seekbar_thumb_glow_30" />
        </shape>
    </item>

    <!-- Drop shadow halo 4 (~2dp blur, matches Figma 50% opacity drop shadow) -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <size
                android:width="26dp"
                android:height="26dp" />
            <solid android:color="@color/color_seekbar_thumb_glow_50" />
        </shape>
    </item>

    <!-- Center solid thumb circle (#FFD54F) -->
    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <size
                android:width="22dp"
                android:height="22dp" />
            <solid android:color="@color/color_seekbar_thumb" />
        </shape>
    </item>
</layer-list>
