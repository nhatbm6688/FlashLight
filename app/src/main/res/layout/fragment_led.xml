<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- 1. LED Preview Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLedPreview"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.af.flashlight.component.led.view.LedBannerView
                    android:id="@+id/viewLedPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Expand Button (Top Right) -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnExpand"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="end|top"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_preview_expand_btn"
                    android:clickable="true"
                    android:contentDescription="@string/led_title"
                    android:focusable="true"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_expand" />

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- 2. Text Input Card -->
        <LinearLayout
            android:id="@+id/cardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_screenlight_card"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                android:text="@string/text_label"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etLedText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_led_input_box"
                android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                android:hint="@string/default_led_text"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:text="@string/default_led_text"
                android:textColor="@color/white"
                android:textColorHint="@color/gray3"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 3. Sliders Card (Font Size & Scroll Speed) -->
        <LinearLayout
            android:id="@+id/cardSliders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_screenlight_card"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Font Size -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvFontSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                    android:text="@string/font_size"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvFontSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="64px"
                    android:textColor="@color/color_main"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/sbFontSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:max="100"
                android:paddingStart="@dimen/size18"
                android:paddingEnd="@dimen/size18"
                android:paddingTop="@dimen/size6"
                android:paddingBottom="@dimen/size6"
                android:progress="50"
                android:progressDrawable="@drawable/bg_brightness_seekbar_track"
                android:splitTrack="false"
                android:thumb="@drawable/bg_brightness_seekbar_thumb"
                android:thumbOffset="@dimen/size18" />

            <!-- Scroll Speed -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvScrollSpeedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                    android:text="@string/scroll_speed"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvScrollSpeedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="5s"
                    android:textColor="@color/color_main"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/sbScrollSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:max="9"
                android:paddingStart="@dimen/size18"
                android:paddingEnd="@dimen/size18"
                android:paddingTop="@dimen/size6"
                android:paddingBottom="@dimen/size6"
                android:progress="4"
                android:progressDrawable="@drawable/bg_brightness_seekbar_track"
                android:splitTrack="false"
                android:thumb="@drawable/bg_brightness_seekbar_thumb"
                android:thumbOffset="@dimen/size18" />

        </LinearLayout>

        <!-- 4. Color Card -->
        <LinearLayout
            android:id="@+id/cardColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_screenlight_card"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvColorLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                android:text="@string/color"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <!-- Row 1: ic_draw + Cyan + White + Yellow + Green -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Custom Color Picker Button -->
                <FrameLayout
                    android:id="@+id/containerColorPicker"
                    style="@style/StyleColorItemContainer">

                    <View
                        android:id="@+id/ringColorPicker"
                        style="@style/StyleColorSelectionRing"
                        tools:visibility="visible" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnCustomColorPicker"
                        style="@style/StyleColorPickerButton" />

                </FrameLayout>

                <!-- 1. Cyan -->
                <FrameLayout
                    android:id="@+id/containerColorCyan"
                    style="@style/StyleColorItemContainer">

                    <View
                        android:id="@+id/ringColorCyan"
                        style="@style/StyleColorSelectionRing" />

                    <View
                        android:id="@+id/circleColorCyan"
                        style="@style/StyleColorCircleInner"
                        android:backgroundTint="@color/color_screenlight_preset_cyan" />
                </FrameLayout>

                <!-- 2. White -->
                <FrameLayout
                    android:id="@+id/containerColorWhite"
                    style="@style/StyleColorItemContainer">

                    <View
                        android:id="@+id/ringColorWhite"
                        style="@style/StyleColorSelectionRing" />

                    <View
                        android:id="@+id/circleColorWhite"
                        style="@style/StyleColorCircleInner"
                        android:backgroundTint="@color/color_screenlight_preset_white" />
                </FrameLayout>

                <!-- 3. Yellow (Default selected) -->
                <FrameLayout
                    android:id="@+id/containerColorYellow"
                    style="@style/StyleColorItemContainer">

                    <View
                        android:id="@+id/ringColorYellow"
                        style="@style/StyleColorSelectionRing"
                        android:visibility="visible" />

                    <View
                        android:id="@+id/circleColorYellow"
                        style="@style/StyleColorCircleInner"
                        android:backgroundTint="@color/color_screenlight_preset_yellow" />
                </FrameLayout>

                <!-- 4. Green -->
                <FrameLayout
                    android:id="@+id/containerColorGreen"
                    style="@style/StyleColorItemContainer">

                    <View
                        android:id="@+id/ringColorGreen"
                        style="@style/StyleColorSelectionRing" />

                    <View
                        android:id="@+id/circleColorGreen"
                        style="@style/StyleColorCircleInner"
                        android:backgroundTint="@color/color_screenlight_preset_green" />
                </FrameLayout>

            </LinearLayout>

            <!-- Row 2: Purple + Coral -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 5. Purple -->
                <FrameLayout
                    android:id="@+id/containerColorPurple"
                    style="@style/StyleColorItemContainer">

                    <View
                        android:id="@+id/ringColorPurple"
                        style="@style/StyleColorSelectionRing" />

                    <View
                        android:id="@+id/circleColorPurple"
                        style="@style/StyleColorCircleInner"
                        android:backgroundTint="@color/color_screenlight_preset_purple" />
                </FrameLayout>

                <!-- 6. Coral -->
                <FrameLayout
                    android:id="@+id/containerColorCoral"
                    style="@style/StyleColorItemContainer">

                    <View
                        android:id="@+id/ringColorCoral"
                        style="@style/StyleColorSelectionRing" />

                    <View
                        android:id="@+id/circleColorCoral"
                        style="@style/StyleColorCircleInner"
                        android:backgroundTint="@color/color_screenlight_preset_coral" />
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 5. Direction Card -->
        <LinearLayout
            android:id="@+id/cardDirection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_screenlight_card"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDirectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                android:text="@string/direction"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Right Arrow -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnDirectionRight"
                    style="@style/StyleLedDirectionButton" />

                <!-- Left Arrow (Default selected) -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnDirectionLeft"
                    style="@style/StyleLedDirectionButton"
                    android:layout_marginStart="12dp"
                    android:rotation="180" />

                <!-- Down Arrow -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnDirectionDown"
                    style="@style/StyleLedDirectionButton"
                    android:layout_marginStart="12dp"
                    android:rotation="90" />

                <!-- Up Arrow -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnDirectionUp"
                    style="@style/StyleLedDirectionButton"
                    android:layout_marginStart="12dp"
                    android:rotation="270" />

            </LinearLayout>

        </LinearLayout>

        <!-- 6. Visual Effects Card -->
        <LinearLayout
            android:id="@+id/cardVisualEffects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_screenlight_card"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvVisualEffectsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                android:text="@string/visual_effects"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <!-- Dynamic Flow: Glow, Blink, Neon, Fade in one responsive flow -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <!-- Glow (Default selected) -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEffectGlow"
                    style="@style/StyleLedPillButton"
                    android:text="@string/effect_glow" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEffectBlink"
                    style="@style/StyleLedPillButton"
                    android:text="@string/effect_blink" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEffectNeon"
                    style="@style/StyleLedPillButton"
                    android:text="@string/effect_neon" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEffectFade"
                    style="@style/StyleLedPillButton"
                    android:text="@string/effect_fade" />

                <androidx.constraintlayout.helper.widget.Flow
                    android:id="@+id/flowVisualEffects"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="btnEffectGlow,btnEffectBlink,btnEffectNeon,btnEffectFade"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="10dp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalGap="10dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <!-- 7. Background Card -->
        <LinearLayout
            android:id="@+id/cardBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_screenlight_card"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBackgroundLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_semi_bold"
                android:text="@string/background_label"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBackgrounds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/item_led_background" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
