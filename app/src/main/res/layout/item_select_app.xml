<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginHorizontal="@dimen/size15"
    android:layout_marginTop="10dp"
    android:background="@drawable/background_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/size15">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivAppIcon"
        android:layout_width="@dimen/size36"
        android:layout_height="@dimen/size36"
        android:layout_marginEnd="@dimen/size15"
        android:scaleType="fitCenter"
        tools:srcCompat="@drawable/ic_notification" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAppName"
        style="@style/StyleSettingTitle"
        tools:text="Facebook" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCheckbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:srcCompat="@drawable/ic_checkbox_normal" />

</LinearLayout>
