<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StyleYellowButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size48</item>
        <item name="android:layout_marginStart">@dimen/size15</item>
        <item name="android:layout_marginEnd">@dimen/size15</item>
        <item name="android:background">@drawable/bg_yellow_button_selector</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StyleSubmitButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size48</item>
        <item name="android:layout_marginStart">@dimen/size20</item>
        <item name="android:layout_marginEnd">@dimen/size20</item>
        <item name="android:background">@drawable/bg_yellow_button_selector</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StyleOBDButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/size44</item>
        <item name="android:background">@drawable/bg_obd_yellow_butotn</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StyleTransparentButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size48</item>
        <item name="android:layout_marginStart">@dimen/size15</item>
        <item name="android:layout_marginEnd">@dimen/size15</item>
        <item name="android:background">@drawable/background_transparent_selector</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="android:gravity">center</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.App.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:includeFontPadding">false</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semi_bold</item>
    </style>

    <style name="CustomProgressLoading" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.Dialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@color/transparent_50</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="BottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <!-- Setting Component Style Templates (Constitution Compliance) -->
    <style name="StyleSettingCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size56</item>
        <item name="android:layout_marginStart">@dimen/size15</item>
        <item name="android:layout_marginEnd">@dimen/size15</item>
        <item name="android:layout_marginTop">@dimen/size12</item>
        <item name="android:paddingStart">@dimen/size15</item>
        <item name="android:paddingEnd">@dimen/size15</item>
        <item name="android:background">@drawable/background_item</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="StyleSettingIcon">
        <item name="android:layout_width">@dimen/size36</item>
        <item name="android:layout_height">@dimen/size36</item>
        <item name="android:layout_marginEnd">@dimen/size15</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="StyleSettingTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semi_bold</item>
    </style>

    <style name="StyleSettingValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_yellow</item>
        <item name="android:textSize">@dimen/size16</item>
        <item name="android:layout_marginEnd">@dimen/size6</item>
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
    </style>

    <style name="StyleSettingArrow">
        <item name="android:layout_width">@dimen/size20</item>
        <item name="android:layout_height">@dimen/size20</item>
        <item name="android:scaleType">fitCenter</item>
    </style>


    <!-- Reusable Mode Tab Button Styles -->
    <style name="StyleModeTabContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">75dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">@dimen/size10</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_mode_tab_selector</item>
    </style>

    <style name="StyleModeTabIcon">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="tint">@color/color_mode_tab_selector</item>
        <item name="android:tint">@color/color_mode_tab_selector</item>
    </style>

    <style name="StyleModeTabText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:textColor">@color/color_mode_tab_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">10sp</item>
        <item name="android:autoSizeMinTextSize">10sp</item>
        <item name="autoSizeMaxTextSize">13sp</item>
        <item name="android:autoSizeMaxTextSize">13sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>

    <!-- Reusable Bottom Navigation Styles -->
    <style name="StyleBottomNavTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="StyleBottomNavContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">7dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:background">@drawable/bg_bottom_nav_selector</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="StyleBottomNavIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="tint">@color/color_bottom_nav_selector</item>
        <item name="android:tint">@color/color_bottom_nav_selector</item>
    </style>

    <style name="StyleBottomNavText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:textColor">@color/color_bottom_nav_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="autoSizeMaxTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">12sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>

    <!-- Reusable Color Selection Component Styles -->
    <style name="StyleColorItemContainer">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="StyleColorSelectionRing">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/bg_color_circle_active</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="StyleColorCircleInner">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/bg_circle_color</item>
    </style>

    <style name="StyleColorPickerButton">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/bg_color_picker_btn</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_draw</item>
        <item name="android:contentDescription">@string/color</item>
    </style>

    <!-- Reusable LED Component Styles -->
    <style name="StyleLedSquareButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_led_square_btn_selector</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">20dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/color_led_option_icon_selector</item>
        <item name="android:tint">@color/color_led_option_icon_selector</item>
    </style>

    <style name="StyleLedDirectionButton" parent="StyleLedSquareButton">
        <item name="android:src">@drawable/ic_arrow</item>
        <item name="android:contentDescription">@string/direction</item>
    </style>

    <style name="StyleLedPillButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/size40</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:background">@drawable/bg_led_pill_chip_selector</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/color_led_pill_chip_text_selector</item>
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semi_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
