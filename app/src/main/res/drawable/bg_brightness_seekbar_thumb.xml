<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer subtle glow -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="oval">
            <size
                android:width="26dp"
                android:height="26dp" />
            <solid android:color="@color/color_screenlight_seekbar_thumb_glow" />
        </shape>
    </item>
    <!-- Inner solid thumb -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <size
                android:width="20dp"
                android:height="20dp" />
            <solid android:color="@color/color_screenlight_seekbar_progress" />
            <stroke
                android:width="2dp"
                android:color="@color/white" />
        </shape>
    </item>
</layer-list>
