<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#C68C15"
                android:startColor="#E6B414" />
            <corners android:radius="@dimen/size50" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <gradient
                android:angle="0"
                android:endColor="@color/yellow_btn_gradient_end"
                android:startColor="@color/yellow_btn_gradient_start" />
            <corners android:radius="@dimen/size50" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#9097A2" />
            <corners android:radius="@dimen/size50" />
        </shape>
    </item>
</selector>
